# goalx 环境变量模板（复制为 .env 使用；.env 已被 gitignore，勿提交真实 key）
# 管理决策与用途见 .scratch/goalx-quant/（票 02/07）

# --- 数据源（票 02/13 选型）---

# API-Football (api-sports.io)：赛事/阵容/伤停/场馆，免费档 100 请求/天
# 注册: https://dashboard.api-football.com/register （免费，无需信用卡）
API_FOOTBALL_KEY=

# The Odds API：多 bookmaker 赔率快照（h2h/totals），免费档 500 credits/月
# 注册: https://the-odds-api.com/account/create （免费）
ODDS_API_KEY=

# PropLine：第二欧赔源（票 50 互备/交叉验证），免费档 1,000 请求/天
# 注册: https://prop-line.com/ （仅邮箱，无需信用卡）
PROPLINE_API_KEY=

# 以下源无需 key（已实测可达）：
#   open-meteo        天气（非商业免费，无 key）
#   football-data.co.uk 历史 CSV（无 key）
#   sporttery 网关     竞彩官方赛程/赔率（须带 Referer 头）
#   500.com / okooo    历史开奖/欧赔/人气分布（页面解析）

# --- 源T（srct）轨迹语料（票 55 切片 11）---
# 代称红线：端点真值不落码库，只进本地 .env（事实源 .scratch/goalx-quant/research/20 §二）
# {date}=YYYYMMDD、{sid}=场次 id；模板示例为占位，非真实地址
GOALX_SRCT_DAY_URL=https://srct.invalid/football/Over_{date}.htm
GOALX_SRCT_ODDS_URL=https://srct.invalid/{sid}.js
GOALX_SRCT_ODDS_REFERER=https://srct.invalid/oddslist/{sid}.htm

# CorpusStore 语料树根（默认 ~/goalx-data/，换机/外置盘改这里）
# GOALX_CORPUS_ROOT=

